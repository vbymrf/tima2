-- Схема 17 → 18: групповой звонок в журнале звонков (заказчик 2026-10-08).
--
-- Вкладка «Звонки» показывает групповые звонки строкой с «ГЗ»; у такой строки нет
-- собеседника, зато есть группа — по ней нажатие открывает чат звонка, а кнопка повторяет
-- звонок или входит в идущий. Пусто — звонок личный.
ALTER TABLE call_log ADD COLUMN group_id TEXT NOT NULL DEFAULT '';
