-- Схема 9 → 10: раздел у переписки и набор разделов сообществ (решение заказчика 2026-09-18,
-- ПЛАН-РАЗДЕЛОВ Р5, doc/01-product/разделы.md «Наборы разделов»).
--
-- Наборов разделов столько, сколько сущностей: у контактов — `book_section`, у групп,
-- каналов, сообществ и аудио — этот. Отдельной таблицей, а не признаком в общей: наборы
-- не пересекаются ни именами, ни порядком, и «Работа» контактов и «Работа» сообществ —
-- разные разделы с одинаковым словом. Строение то же, что у `book_section`: устойчивый
-- `id`, имя, индекс значка, порядок.
CREATE TABLE community_section (
    id    TEXT    NOT NULL PRIMARY KEY,
    name  TEXT    NOT NULL,
    icon  INTEGER NOT NULL DEFAULT 0,
    place INTEGER NOT NULL DEFAULT 0
);

-- Раздел переписки. Пустая строка — «Общий». У личной переписки поле не используется:
-- её раздел — раздел собеседника в книге; своё поле было бы второй правдой.
ALTER TABLE chats ADD COLUMN section_id TEXT NOT NULL DEFAULT '';
