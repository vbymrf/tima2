-- Журнал звонков на устройстве — ПЛАН-ЖУРНАЛА-ЗВОНКОВ.md, Ж2.
--
-- ── ЗДЕСЬ КОПИЯ, А НЕ ИСТОЧНИК ПРАВДЫ ───────────────────────────────────────
--
-- И этим таблица отличается от `messages`, хотя читается экраном так же. Историю
-- переписки сервер прочитать не может вовсе — он почта, а не архив, и местная база
-- единственное место, где она существует в открытом виде. Потерять её значит потерять
-- навсегда.
--
-- Строку звонка заводит сервер: он знает, кто кому звонил, когда взяли трубку и чем
-- кончилось. Здесь она лежит, чтобы журнал открывался без сети и без ожидания. Потерять
-- её стоит одного запроса.
--
-- Отсюда правило на все расхождения: **серверное побеждает**. Обновление перезаписывает
-- строку целиком, и спорить местному нечем.
--
-- ── ЧЕГО ЗДЕСЬ НЕТ ──────────────────────────────────────────────────────────
--
-- **Имени и лица.** Они приезжают из книги в момент показа — тем же способом, что везде.
-- Положить имя сюда значило бы завести ему второй источник правды: человека переименовали
-- в книге, а в журнале он остался прежним. Ровно за это `Chats.sq` выговаривает наброску
-- схемы.
--
-- **Поэтому и шифровать здесь нечего.** В `chats` закрыт `title_enc` и открыт `peer_id`:
-- имя это содержимое, идентификатор это метаданные. В журнале звонков нет ни одной
-- строки текста — только идентификаторы, времена и состояния.
CREATE TABLE call_log (
    call_id      TEXT    NOT NULL PRIMARY KEY,
    -- 0 — голосом, 1 — видео. Та самая кнопка, которой звонили: повтор из журнала
    -- звонит тем же видом, и ради этого поле здесь в первую очередь.
    video        INTEGER NOT NULL DEFAULT 0,
    -- ringing | answered | ended | missed | busy | lost. Строкой, а не числом: значения
    -- приходят с сервера, и новое не должно ломать разбор старого клиента.
    state        TEXT    NOT NULL,
    initiator_id TEXT    NOT NULL,
    peer_id      TEXT    NOT NULL,
    -- Кто положил трубку. Пусто — не клал никто: звонок закрыл уборщик или SFU. Без
    -- этого «отменил» и «отклонил» неразличимы — `/end` зовут обе стороны.
    ended_by     TEXT    NOT NULL DEFAULT '',
    created_at   INTEGER NOT NULL,
    -- 0 — трубку не брали. Ноль вместо NULL: так же, как `book.updated_at`, и тип в
    -- Kotlin выходит без вопросительного знака на каждом обращении.
    answered_at  INTEGER NOT NULL DEFAULT 0,
    -- 0 — звонок ещё числится идущим.
    ended_at     INTEGER NOT NULL DEFAULT 0,
    -- ── ЕДИНСТВЕННОЕ МЕСТНОЕ ПОЛЕ ───────────────────────────────────────────
    --
    -- «Просмотрено» сервер знать не может: он не видит, что человек открыл вкладку.
    -- Принцип тот же, что у непрочитанных сообщений, — **состояние лежит в строке, а
    -- счётчик считается запросом** (`messages.state`, `unreadInChat`). Водяного знака
    -- «досмотрел до такого-то времени» в проекте нет нигде, и заводить его здесь
    -- значило бы завести второй принцип на третий счётчик.
    --
    -- Из-за него же обновление пишется двумя запросами, а не `INSERT OR REPLACE`: тот
    -- сносит строку целиком и отметку вместе с ней.
    seen         INTEGER NOT NULL DEFAULT 0
);

-- Журнал читается только в одном порядке — новые сверху.
CREATE INDEX call_log_time ON call_log(created_at DESC);

-- Страница журнала. `limit` приходит из настройки «Память и трафик», а не из константы.
page:
SELECT * FROM call_log ORDER BY created_at DESC LIMIT ?;

-- ── Обновление строки: два запроса вместо UPSERT ────────────────────────────
--
-- Диалект здесь SQLite 3.18, `ON CONFLICT DO UPDATE` появился в 3.24 (то же, что в
-- `Book.sq` и `Settings.sq`). А `INSERT OR REPLACE` не годится по другой причине: он
-- удаляет строку и вставляет заново, унося местное `seen`.
--
-- `seen` не упомянут в UPDATE намеренно: серверное побеждает во всём, кроме него.
update:
UPDATE call_log SET
    video = :video, state = :state, initiator_id = :initiatorId, peer_id = :peerId,
    ended_by = :endedBy, created_at = :createdAt, answered_at = :answeredAt,
    ended_at = :endedAt
WHERE call_id = :callId;

insert:
INSERT OR IGNORE INTO call_log (
    call_id, video, state, initiator_id, peer_id, ended_by,
    created_at, answered_at, ended_at
) VALUES (?,?,?,?,?,?,?,?,?);

-- ── Счётчик пропущенных ─────────────────────────────────────────────────────
--
-- `initiator_id <> :me` обязательно. У звонившего `missed` означает «не дозвонился», и
-- в счётчик пропущенных это не идёт: он отвечает на «кому я не ответил», а не «кому я
-- не дозвонился». Сложи их — и число перестанет значить что-либо.
missedUnseen:
SELECT count(*) FROM call_log
WHERE seen = 0 AND state = 'missed' AND initiator_id <> :me;

-- Сколько строк вообще не просмотрено.
--
-- Нужен, чтобы НЕ выполнять markSeen, когда отмечать нечего. Причина та же, что у
-- `Messages.sq unreadInChat`: SQLDelight будит слушателей таблицы по факту выполнения
-- изменяющего запроса, а не по числу изменённых строк. Отметка внутри сборщика ленты
-- разбудила бы запрос, запрос позвал бы отметку снова — и приложение ушло бы в круг.
-- Поймано на realme 2026-09-17, 210 % процессора.
unseen:
SELECT count(*) FROM call_log WHERE seen = 0;

markSeen:
UPDATE call_log SET seen = 1 WHERE seen = 0;

-- ── Уборка по настройке «Память и трафик» ───────────────────────────────────
--
-- Два предела, срабатывает тот, что наступит раньше, — как у дневника. Срок защищает от
-- давности, число — от месяца, в котором звонили каждый час.
--
-- Сервер при этом не удаляет ничего: строка звонка это одни метаданные. Здесь убирается
-- копия, и убранное всегда можно доспросить.
pruneByAge:
DELETE FROM call_log WHERE created_at < :olderThan;

pruneByCount:
DELETE FROM call_log WHERE call_id NOT IN (
    SELECT call_id FROM call_log ORDER BY created_at DESC LIMIT :keep
);

-- Сколько строк лежит — для строки «занимает» в настройках и для решения, звать ли уборку.
count:
SELECT count(*) FROM call_log;

-- Самая старая известная строка: с неё продолжается страница, когда долистали до низа.
oldest:
SELECT min(created_at) FROM call_log;
