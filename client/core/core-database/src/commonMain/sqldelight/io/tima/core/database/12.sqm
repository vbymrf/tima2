-- Схема 12 → 13: журнал звонков на устройстве (ПЛАН-ЖУРНАЛА-ЗВОНКОВ.md, Ж2).
--
-- Вкладка «Звонки» была заглушкой с самого начала. Журнал живёт на сервере — устройств у
-- человека несколько, и собранный на телефоне он на планшете был бы другим. Здесь копия:
-- чтобы вкладка открывалась без сети и без ожидания.
--
-- Потерять эту таблицу не страшно — в отличие от `messages`, где лежит единственная
-- открытая копия переписки. Здесь потеря стоит одного запроса к серверу.
--
-- Местное поле ровно одно — `seen`. «Просмотрено» сервер знать не может: он не видит,
-- что человек открыл вкладку.
CREATE TABLE call_log (
    call_id      TEXT    NOT NULL PRIMARY KEY,
    video        INTEGER NOT NULL DEFAULT 0,
    state        TEXT    NOT NULL,
    initiator_id TEXT    NOT NULL,
    peer_id      TEXT    NOT NULL,
    ended_by     TEXT    NOT NULL DEFAULT '',
    created_at   INTEGER NOT NULL,
    answered_at  INTEGER NOT NULL DEFAULT 0,
    ended_at     INTEGER NOT NULL DEFAULT 0,
    seen         INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX call_log_time ON call_log(created_at DESC);
