-- Групповые ключи (GK) — crypto-protocol.md §4.
--
-- ── ЗАЧЕМ ХРАНИТЬ ВСЕ ВЕРСИИ, А НЕ ПОСЛЕДНЮЮ ────────────────────────────────
--
-- Сообщение зашифровано тем ключом, который был текущим в момент отправки, и его версия
-- едет в конверте. Ротация происходит при каждом входе и выходе участника — то есть
-- переписка недельной давности почти наверняка лежит под старой версией. Храни только
-- последнюю, и вся история группы становится нечитаемой при первом же новом участнике.
--
-- Обратное правило тоже важно: **старую версию нельзя выдавать новому участнику**. Он не
-- получит её обёртку от сервера, и это не наша забота — сервер раскладывает обёртки только
-- тем устройствам, что были в списке получателей ротации.
--
-- ── ЧТО ЛЕЖИТ ПОД ШИФРОМ ────────────────────────────────────────────────────
--
-- Сам ключ. Тем же ключом покоя, что тело сообщения: GK открывает всю переписку группы, и
-- лежать открытым он не может нигде — ни в файле базы, ни в резервной копии телефона.
CREATE TABLE group_keys (
    group_id TEXT    NOT NULL,
    -- Версия GK: та, что едет в конверте сообщения. Строго растёт, ротацию делает админ.
    version  INTEGER NOT NULL,
    -- Сам ключ под шифром покоя (LocalStoreCipher).
    key_enc  BLOB    NOT NULL,
    -- Сколько сообщений мы отправили под этой версией (ADR-0017 §1). Порог в 10 000
    -- ограничивает объём, который раскроется при утечке ключа; это оптимизация, а не
    -- гарантия — гарантию даёт ротация по смене эпохи escrow.
    sent_count INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (group_id, version)
);

-- Запись ключа. INSERT OR REPLACE, а не UPSERT: диалект sqlite_3_18 (minSdk 26), UPSERT
-- появился в 3.24. Замена здесь равнозначна — оба столбца задаются, ссылок на строку нет.
putGroupKey:
INSERT OR REPLACE INTO group_keys(group_id, version, key_enc)
VALUES (?, ?, ?);

-- Ключ конкретной версии: им расшифровывается сообщение, назвавшее эту версию.
groupKey:
SELECT key_enc FROM group_keys WHERE group_id = ? AND version = ?;

-- Самая свежая известная нам версия: ею шифруется исходящее.
--
-- MAX(version) вместо ORDER BY + LIMIT: генератор считает результат агрегата обнуляемым, и
-- это правда — у группы без ключей ответа нет. Признак «ключей нет» получается сам собой.
latestGroupKey:
SELECT MAX(version) AS version FROM group_keys WHERE group_id = ?;

-- Все версии, которые у нас есть: по ним видно, какие обёртки просить у сервера.
groupKeyVersions:
SELECT version FROM group_keys WHERE group_id = ? ORDER BY version;

-- Стирание группы: ключи уходят вместе с сообщениями. Работает вместе с PRAGMA
-- secure_delete — иначе ключ остаётся в файле после «удалено», и это хуже, чем сообщения:
-- по ключу читается вся история.
deleteGroupKeys:
DELETE FROM group_keys WHERE group_id = ?;

-- Отметить отправку под текущей версией. Растёт только у той версии, которой
-- зашифровано: счётчик привязан к ключу, а не к группе.
bumpSentCount:
UPDATE group_keys SET sent_count = sent_count + 1 WHERE group_id = ? AND version = ?;

-- Сколько отправлено под версией. Нужен, чтобы решить, не пора ли ротировать.
sentCount:
SELECT sent_count FROM group_keys WHERE group_id = ? AND version = ?;
