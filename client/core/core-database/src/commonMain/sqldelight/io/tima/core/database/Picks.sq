-- Подборка сообщений — указатели (doc_mig/РЕДАКТОР-СООБЩЕНИЙ.md §11.2, ПЛАН-(УК)): ссылки, а не
-- копии; своя у сообщества, группы, канала, у каждой личной переписки; на устройстве; до 100 на
-- уровень. Строение — как в 19.sqm; раздел указателя — миграция 22 → 23 (пусто — «Общий»).
CREATE TABLE picks (
    level_key TEXT    NOT NULL,
    chat_id   TEXT    NOT NULL,
    server_id INTEGER NOT NULL,
    added_at  INTEGER NOT NULL,
    section_id TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (level_key, chat_id, server_id)
);

-- Разделы указателей (ПЛАН-(УК) УК1–УК2): строение — как у `community_section`; набор свой.
CREATE TABLE pointer_section (
    id    TEXT    NOT NULL PRIMARY KEY,
    name  TEXT    NOT NULL,
    icon  INTEGER NOT NULL DEFAULT 0,
    place INTEGER NOT NULL DEFAULT 0
);

-- Сообщение-цель, полученное с сервера по номеру (заказчик 2026-10-21: «храним»): ответ сервера,
-- закрытый ключом устройства. `kind` — `frame` (кадр группы) или `open` (открытая запись).
CREATE TABLE ref_cache (
    chat_id   TEXT    NOT NULL,
    server_id INTEGER NOT NULL,
    kind      TEXT    NOT NULL,
    body_enc  BLOB    NOT NULL,
    PRIMARY KEY (chat_id, server_id)
);

hasPick:
SELECT count(*) FROM picks WHERE level_key = ? AND chat_id = ? AND server_id = ?;

countPicks:
SELECT count(*) FROM picks WHERE level_key = ?;

addPick:
INSERT OR IGNORE INTO picks(level_key, chat_id, server_id, added_at) VALUES (?, ?, ?, ?);

picksOf:
SELECT * FROM picks WHERE level_key = ? ORDER BY added_at DESC;

-- Личные: у каждой переписки свой уровень, редактор вставляет из всех личных разом.
picksLike:
SELECT * FROM picks WHERE level_key LIKE ? ORDER BY added_at DESC;

allPicks:
SELECT * FROM picks ORDER BY added_at DESC;

removePick:
DELETE FROM picks WHERE level_key = ? AND chat_id = ? AND server_id = ?;

removeLevel:
DELETE FROM picks WHERE level_key = ?;

movePick:
UPDATE picks SET section_id = ? WHERE level_key = ? AND chat_id = ? AND server_id = ?;

-- ── Разделы указателей ───────────────────────────────────────────────────────
--
-- Те же пять запросов, что у разделов книги и сообществ: механизм один, наборы разные.
pointerSections:
SELECT id, name, icon, place FROM pointer_section ORDER BY place, name;

pointerSectionByName:
SELECT id FROM pointer_section WHERE lower(name) = lower(?) LIMIT 1;

addPointerSection:
INSERT INTO pointer_section (id, name, icon, place) VALUES (?, ?, ?, ?);

renamePointerSection:
UPDATE pointer_section SET name = ?, icon = ? WHERE id = ?;

placePointerSection:
UPDATE pointer_section SET place = ? WHERE id = ?;

removePointerSection:
DELETE FROM pointer_section WHERE id = ?;

-- Указатели убранного раздела возвращаются в «Общий», а не исчезают вместе с ним.
emptyPointerSection:
UPDATE picks SET section_id = '' WHERE section_id = ?;

-- ── Сообщения-цели ───────────────────────────────────────────────────────────
refCached:
SELECT kind, body_enc FROM ref_cache WHERE chat_id = ? AND server_id = ?;

putRef:
INSERT OR REPLACE INTO ref_cache(chat_id, server_id, kind, body_enc) VALUES (?, ?, ?, ?);

dropRef:
DELETE FROM ref_cache WHERE chat_id = ? AND server_id = ?;
