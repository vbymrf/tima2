-- Схема 18 → 19: правка сообщения (ADR-0045, решение заказчика 2026-10-18 «Правку делаем новой
-- версией конверта»).
--
-- Правка — новая запись с номером исходного; 0 — обычное сообщение. В ленте правка отдельной
-- строкой не идёт, в списке переписок не последняя и непрочитанным не считается.
ALTER TABLE messages ADD COLUMN edit_of INTEGER NOT NULL DEFAULT 0;
CREATE INDEX idx_messages_edits ON messages(chat_id, edit_of) WHERE edit_of <> 0;
