-- Схема 7 → 8: ветка в группе (ПЛАН-КАНАЛОВ К6, ADR-0024).
--
-- Ветка — это то же самое, что комментарий, только внутри шифра: сообщение, у которого
-- контейнер не группа, а другое сообщение. Сервер принимает `thread_root` с миграции
-- 0006 и проверяет его на битые ссылки; у клиента этого поля не было вовсе, и потому
-- ветку нечем было ни собрать, ни показать.
--
-- Ноль значит «обычное сообщение», а не NULL: ветка есть или её нет, третьего состояния
-- не бывает, и `NULL` здесь заводил бы проверку на пустоту в каждом сравнении.
ALTER TABLE messages ADD COLUMN thread_root INTEGER NOT NULL DEFAULT 0;

-- Выборка ветки: все ответы одного корня по порядку. Без индекса открытие ветки читает
-- всю переписку.
CREATE INDEX idx_messages_thread ON messages(chat_id, thread_root, local_id);
