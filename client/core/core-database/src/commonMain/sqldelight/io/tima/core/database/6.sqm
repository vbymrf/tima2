-- Схема 6 → 7: настройки экранов (ПЛАН-КОНТАКТОВ.md, Д5).
--
-- Вид вкладки «Контакты» обязан пережить перезапуск: человек выбрал «папки» или «меню»
-- один раз, и спрашивать его об этом снова при каждом запуске — значит не запомнить.
--
-- Пары «имя → значение», а не столбцы: настройки приходят и уходят вместе с экранами, и
-- столбец под каждую галку означал бы миграцию на каждую галку.
CREATE TABLE setting (
    name  TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);
