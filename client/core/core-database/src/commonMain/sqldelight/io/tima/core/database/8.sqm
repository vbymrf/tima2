-- Схема 8 → 9: у раздела книги появляются устойчивый идентификатор и значок
-- (решение заказчика 2026-09-18, doc/01-product/разделы.md «Где раздел живёт»).
--
-- ── ПОЧЕМУ ИДЕНТИФИКАТОР, А НЕ ИМЯ ─────────────────────────────────────────
--
-- До этой миграции раздел БЫЛ своим именем: `book_section.name` — ключ, и контакт ссылался
-- на раздел строкой `book.section`. Переименовать раздел значило сменить ключ и переписать
-- ссылки у всех его контактов. На одном устройстве это транзакция; между двумя — беда:
-- телефон переименовал «Работа» в «Офис», ПК за это время положил туда контакт под старым
-- именем, и при слиянии копий контакт уходит в раздел, которого больше нет.
--
-- Разделы едут между устройствами внутри зашифрованной копии книги (ПЛАН-КОНТАКТОВ), и
-- ключ обязан переживать переименование. Поэтому `id` — случайный, заводится один раз и
-- не меняется никогда; имя становится обычным полем.
--
-- ── ЗНАЧОК ──────────────────────────────────────────────────────────────────
--
-- Индекс в заданном наборе (`SectionIcon`), а не картинка: набор рисуется клиентом и не
-- загружается. Ноль — «без значка»: у раздела, заведённого до этой миграции, это честное
-- состояние, а не первый попавшийся рисунок. Индексы набора только ДОПИСЫВАЮТСЯ: индекс
-- уезжает на другое устройство, и переставленный набор подменил бы значки всем разделам.
--
-- ── ПОЧЕМУ ТАБЛИЦЫ ПЕРЕСОБИРАЮТСЯ ───────────────────────────────────────────
--
-- SQLite этих версий (Android 8 — 3.18) не умеет ни сменить первичный ключ через ALTER, ни
-- убрать колонку. Единственный честный путь — новая таблица, перенос, замена. Данные при
-- этом переживают: у каждого прежнего раздела появляется `id`, а ссылки контактов
-- переводятся с имени на него через соединение по имени.

CREATE TABLE book_section_v9 (
    id    TEXT    NOT NULL PRIMARY KEY,
    name  TEXT    NOT NULL,
    icon  INTEGER NOT NULL DEFAULT 0,
    place INTEGER NOT NULL DEFAULT 0
);

INSERT INTO book_section_v9 (id, name, icon, place)
SELECT lower(hex(randomblob(16))), name, 0, place FROM book_section;

CREATE TABLE book_v9 (
    phone          TEXT    NOT NULL PRIMARY KEY,
    name_phone_enc BLOB,
    name_own_enc   BLOB,
    -- Идентификатор раздела. Пустая строка — «Общий»: он существует без своей строки в
    -- разделах, это отсутствие раздела, а не раздел с пустым именем.
    section_id     TEXT    NOT NULL DEFAULT '',
    user_id        TEXT,
    manual         INTEGER NOT NULL DEFAULT 0,
    hidden         INTEGER NOT NULL DEFAULT 0
);

-- Ссылка переводится с имени на идентификатор. Контакт с именем раздела, которого в
-- разделах нет (так бывало до починки 2026-09-17: имя набирали руками, строки раздела не
-- заводилось), уходит в «Общий» — там его хотя бы видно.
INSERT INTO book_v9 (phone, name_phone_enc, name_own_enc, section_id, user_id, manual, hidden)
SELECT b.phone, b.name_phone_enc, b.name_own_enc,
       COALESCE((SELECT s.id FROM book_section_v9 s WHERE s.name = b.section), ''),
       b.user_id, b.manual, b.hidden
FROM book b;

DROP INDEX IF EXISTS book_by_section;
DROP INDEX IF EXISTS book_by_user;
DROP TABLE book;
DROP TABLE book_section;

ALTER TABLE book_v9 RENAME TO book;
ALTER TABLE book_section_v9 RENAME TO book_section;

CREATE INDEX book_by_section ON book (section_id);
CREATE INDEX book_by_user ON book (user_id);
