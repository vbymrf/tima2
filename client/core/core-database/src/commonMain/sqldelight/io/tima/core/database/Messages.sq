-- Локальное хранилище сообщений — Plan.md §3.4.2.
--
-- ── ЧТО ЗДЕСЬ РЕШЕНО И ПОЧЕМУ ───────────────────────────────────────────────
--
-- 1. Очередь исходящих — СТОЛБЦЫ ЭТОЙ ТАБЛИЦЫ (state, attempts, next_attempt_at,
--    dedup_key), а не отдельная таблица. Иначе у одного сообщения снова два
--    источника правды: в v1 список чатов лежал одновременно в SQLite и в
--    chats.json, и они расходились.
--
-- 2. body_enc — те же байты, что уйдут в конверт: zstd(protobuf(MessageBody)),
--    только под локальным ключом вместо ключа сообщения. Один кодек на провод и на
--    диск. В v1 packBody склеивал текст и вложения разделителем \n\0, и nodes с
--    markup через него не проходили вовсе.
--
-- 3. dedup_key UNIQUE — защита от двойной записи, когда догон истории пересёкся с
--    живым каналом. Приём из v1, работает: повторная вставка становится ошибкой
--    уникальности, а не дублем.
--
-- 4. Порядок в чате — по server_ts, если он есть, иначе по client_ts, затем по
--    local_id. Иначе офлайн-сообщения прыгают в списке в момент получения
--    серверных идентификаторов.

CREATE TABLE messages (
    -- Каноническое написание из документации SQLite. NOT NULL здесь не нужен:
    -- INTEGER PRIMARY KEY — псевдоним rowid, нулём он быть не может.
    --
    -- Поправка: сначала я решил, что прежнее «INTEGER NOT NULL PRIMARY KEY
    -- AUTOINCREMENT» и было причиной падения на iOS. Это оказалось неверно —
    -- настоящая ошибка лежала двумя строками ниже в том же выводе и звучала
    -- «table messages already exists». Написание оставлено каноническим, но
    -- виновато было не оно.
    local_id        INTEGER PRIMARY KEY AUTOINCREMENT,
    -- Ключ идемпотентности, назначенный клиентом ДО первой попытки отправки.
    dedup_key       TEXT    NOT NULL UNIQUE,
    -- Приходит с подтверждением сервера; NULL — ещё не отправлено.
    server_id       INTEGER,
    chat_id         TEXT    NOT NULL,
    sender_id       TEXT    NOT NULL,
    -- Часы устройства: они врут, но других на момент составления нет.
    client_ts       INTEGER NOT NULL,
    server_ts       INTEGER,
    -- Направление: 0 — исходящее, 1 — входящее. Столбец обязателен, а не выводится
    -- из данных: у исходящих и входящих РАЗНЫЕ машины состояний, и нумерация у них
    -- совпадает. Без направления состояние 1 означало бы одновременно SEALED у
    -- исходящего и UNDECRYPTABLE у входящего — то есть очередь забирала бы на
    -- отправку нерасшифрованные чужие сообщения.
    direction       INTEGER NOT NULL DEFAULT 0,
    -- Состояние своей машины: OutboxState.ordinal либо IncomingState.ordinal,
    -- смотря по direction.
    state           INTEGER NOT NULL,
    attempts        INTEGER NOT NULL DEFAULT 0,
    next_attempt_at INTEGER,
    reply_to        INTEGER,
    -- Идентификатор ключа эпохи escrow, под который собран конверт; NULL — конверта
    -- нет. Позднее запечатывание: конверт в базе НЕ хранится.
    sealed_epoch    INTEGER,
    -- Почему входящее не расшифровалось: для диагностики и для показа человеку.
    -- NULL у исходящих и у прочитанных.
    undecryptable_reason TEXT,
    body_enc        BLOB    NOT NULL
);

-- Порядок в чате. Индекс повторяет правило сортировки, иначе список чата на
-- нескольких тысячах сообщений начинает сортироваться в памяти.
CREATE INDEX idx_messages_chat_order ON messages(chat_id, server_ts, client_ts, local_id);

-- Очередь: выборка идёт по направлению, состоянию и сроку. Без индекса каждый проход
-- отправки читает всю таблицу.
CREATE INDEX idx_messages_queue ON messages(direction, state, next_attempt_at);

-- ── Очередь исходящих ───────────────────────────────────────────────────────

insertQueued:
INSERT OR IGNORE INTO messages(dedup_key, chat_id, sender_id, client_ts, direction, state, attempts, next_attempt_at, reply_to, body_enc)
VALUES (?, ?, ?, ?, 0, ?, ?, ?, ?, ?);

-- Сколько строк затронула последняя вставка: 0 означает, что dedup_key уже был.
-- Отличать «поставили» от «уже было» обязательно — иначе повторная постановка
-- сбросит счётчик попыток.
changes:
SELECT changes();

byDedupKey:
SELECT * FROM messages WHERE dedup_key = ?;

-- То же в пределах одной переписки: ключ эпохи escrow спрашивается по chat_id, то есть
-- у каждой переписки он свой, и запечатывать «следующее любое» под ключ одной из них
-- значит собрать конверт не тем ключом.
nextQueuedInChat:
SELECT * FROM messages
WHERE direction = 0 AND chat_id = ? AND state = ? AND (next_attempt_at IS NULL OR next_attempt_at <= ?)
ORDER BY local_id
LIMIT 1;

-- Готовое к запечатыванию: в очереди и срок пришёл.
nextQueued:
SELECT * FROM messages
WHERE direction = 0 AND state = ? AND (next_attempt_at IS NULL OR next_attempt_at <= ?)
ORDER BY local_id
LIMIT 1;

-- Запечатанное, ждущее отправки.
nextSealed:
SELECT * FROM messages WHERE direction = 0 AND state = ? ORDER BY local_id LIMIT 1;

updateState:
UPDATE messages
SET state = ?, attempts = ?, next_attempt_at = ?, sealed_epoch = ?, server_id = ?
WHERE dedup_key = ?;

-- Возврат зависшего при старте: SENDING и SEALED снова в очередь. Без этого
-- убитое посреди отправки сообщение остаётся висеть навсегда — дефект v1.
requeueStuck:
UPDATE messages SET state = ?, sealed_epoch = NULL WHERE direction = 0 AND state IN (?, ?);

pending:
SELECT * FROM messages WHERE direction = 0 AND state IN (?, ?, ?) ORDER BY local_id;

-- ── Чтение переписки ────────────────────────────────────────────────────────

-- Порядок: server_ts, если есть, иначе client_ts; при равенстве — local_id.
-- COALESCE, а не два запроса: смешанный список офлайн- и серверных сообщений
-- обязан быть устойчивым.
chatPage:
SELECT * FROM messages
WHERE chat_id = ?
ORDER BY COALESCE(server_ts, client_ts) DESC, local_id DESC
LIMIT ?;

markSent:
UPDATE messages SET state = ?, server_id = ?, server_ts = ?, sealed_epoch = NULL
WHERE dedup_key = ?;

-- ── Стирание ────────────────────────────────────────────────────────────────

-- Физическое удаление одной переписки. Работает вместе с PRAGMA secure_delete:
-- без него DELETE оставляет страницы читаемыми, и «удалено» означает только
-- «не показывается» (ADR-0015).
deleteChat:
DELETE FROM messages WHERE chat_id = ?;

countAll:
SELECT count(*) FROM messages;

-- ── Входящие ────────────────────────────────────────────────────────────────
--
-- Живут в той же таблице и отличаются направлением. Ключом уникальности служит
-- тот же dedup_key: для входящего в него кладётся "chat_id/message_id", то есть
-- идентификатор, назначенный ОТПРАВИТЕЛЕМ и входящий в подпись. Подделать его
-- нельзя, значит по нему и опознаётся повтор — то же сообщение из живого канала и
-- из догона истории даёт одну строку (инвентарь, пункт 8).
--
-- Отдельного индекса под входящие не нужно: idx_messages_queue начинается с
-- direction, и обе выборки идут по нему.

insertIncoming:
INSERT OR IGNORE INTO messages(dedup_key, server_id, chat_id, sender_id, client_ts, direction, state, attempts, body_enc)
VALUES (?, ?, ?, ?, ?, 1, ?, ?, ?);

nextReceived:
SELECT * FROM messages WHERE direction = 1 AND state = ? ORDER BY local_id LIMIT 1;

undecryptable:
SELECT * FROM messages WHERE direction = 1 AND state = ? ORDER BY local_id;

incomingPending:
SELECT * FROM messages WHERE direction = 1 AND state IN (?, ?) ORDER BY local_id;

-- Смена состояния входящего. Причина нечитаемости пишется в отдельный столбец, а не
-- подмешивается в body_enc: тело — шифртекст, и текстовая пометка в нём была бы
-- байтами, которые никто не сможет расшифровать.
-- Разобранное содержимое и ПРОВЕРЕННЫЙ автор на место конверта. Состояние здесь НЕ
-- меняется: его меняет машина входящих отдельным вызовом, и порядок важен — тело ложится
-- раньше состояния, чтобы падение между ними оставило сообщение на повторный разбор, а не
-- потеряло.
--
-- sender_id до разбора пуст намеренно: автор известен только после сошедшейся подписи, а
-- выдуманное значение потом пришлось бы отличать от настоящего.
updateParsed:
UPDATE messages SET body_enc = ?, sender_id = ? WHERE dedup_key = ?;

-- Прочитано: всё разобранное этой переписки. Предусловие в самом запросе — переход идёт
-- ТОЛЬКО из STORED, потому что прочитанным становится разобранное. Неразобранное и
-- нечитаемое остаются непрочитанными: человек их не читал.
markChatRead:
UPDATE messages SET state = :read
WHERE direction = 1 AND chat_id = :chatId AND state = :stored;

updateIncoming:
UPDATE messages SET state = ?, attempts = ?, undecryptable_reason = ? WHERE dedup_key = ?;
