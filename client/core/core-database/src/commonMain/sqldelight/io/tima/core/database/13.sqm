-- Схема 13 → 14: ключ книги перестаёт быть номером, `hidden` становится списком.
-- План: doc_mig/ПЛАН-СПИСКОВ-КОНТАКТОВ.md, задачи Л0, Л3, Л13, Л16.
--
-- ── ПОЧЕМУ ОДНОЙ МИГРАЦИЕЙ, А НЕ ТРЕМЯ ──────────────────────────────────────
--
-- Все три задачи перестраивают одну таблицу. Смена первичного ключа в SQLite — это
-- всё равно «создать новую, перелить, снести старую», и делать это трижды подряд
-- значило бы трижды переписать книгу человека ради того же результата.
--
-- ── ПОЧЕМУ КЛЮЧ БОЛЬШЕ НЕ НОМЕР ─────────────────────────────────────────────
--
-- Виртуальные аккаунты номера не имеют **вовсе** — только ник, — и это полноправный
-- вид пользователя, а не частный случай. При `phone NOT NULL PRIMARY KEY` человек без
-- номера в книге не «не показывается», а **не заводится**.
--
-- Ключ вычислимый, а не случайный:
--
--     id = 'tel:'  || номер      — контакт из телефонной книги
--     id = 'tima:' || user_id    — контакт, добавленный по нику
--
-- Случайный дал бы **двух Ань** после слияния копий телефона и планшета: каждое
-- устройство выдумало бы свой. Вычислимый оба посчитают одинаково.
--
-- Контакт из книги, оказавшийся в TIMa, ключ НЕ меняет: остаётся `tel:`, `user_id`
-- дописывается рядом. Иначе после сверки он на одном устройстве был бы одним
-- человеком, а на другом — другим.
--
-- ── `hidden` СТАНОВИТСЯ СПИСКОМ, А НЕ ПРОПАДАЕТ ─────────────────────────────
--
-- `hidden = 1` означало ровно «убран человеком» — то есть то же, что «Убранные».
-- Совпадает и тонкость с надгробием: убранный не воскресает при сверке с телефоном
-- («без этого удаление выглядело бы неработающим»).
--
-- Поэтому перенос, а не сброс: у людей на телефонах лежат убранные контакты, и они
-- обязаны остаться убранными. Уронить столбец молча значило бы отменить удаление,
-- сделанное месяц назад, — обновлением.

CREATE TABLE book_new (
    -- 'tel:<номер>' либо 'tima:<user_id>'. Вычислим, поэтому слияние копий сходится.
    id             TEXT    NOT NULL PRIMARY KEY,
    -- NULL у контакта по нику: номера у него нет и не будет.
    phone          TEXT,
    name_phone_enc BLOB,
    name_own_enc   BLOB,
    section_id     TEXT    NOT NULL DEFAULT '',
    user_id        TEXT,
    -- 1 — заведён вручную. Такой не исчезает оттого, что в телефонной книге его нет,
    -- и он же отвечает, куда возвращать вынутого из «Убранных».
    manual         INTEGER NOT NULL DEFAULT 0,
    -- 0 — обычный, 1 — убран, 2 — заблокирован. Вместо `hidden`.
    list           INTEGER NOT NULL DEFAULT 0,
    -- Был ли человек в контактах ДО блокировки (Л13). Ставится один раз, в момент
    -- блокировки: проверять потом поздно — строка книги к тому времени есть в любом
    -- случае, блокировка её и заводит.
    known          INTEGER NOT NULL DEFAULT 0,
    updated_at     INTEGER NOT NULL DEFAULT 0,
    device         TEXT    NOT NULL DEFAULT ''
);

INSERT INTO book_new (id, phone, name_phone_enc, name_own_enc, section_id, user_id,
                      manual, list, known, updated_at, device)
SELECT 'tel:' || phone, phone, name_phone_enc, name_own_enc, section_id, user_id,
       manual, hidden, 0, updated_at, device
FROM book;

DROP TABLE book;
ALTER TABLE book_new RENAME TO book;

-- По номеру ищут при сверке с телефонной книгой — каждый проход, пачками по 500.
CREATE INDEX IF NOT EXISTS book_phone ON book(phone);
-- По `user_id` ищут, чтобы не завести одного человека дважды: по номеру и по нику.
CREATE INDEX IF NOT EXISTS book_user ON book(user_id);
