-- Список переписок — Plan.md §3.4.2.
--
-- ── ГЛАВНОЕ РЕШЕНИЕ: СПИСОК ВЫВОДИТСЯ ИЗ СООБЩЕНИЙ ──────────────────────────
--
-- Набросок схемы в плане называл у `chats` поля `preview_enc`, `last_at` и `unread`.
-- Здесь их нет, и это осознанное расхождение с наброском.
--
-- Причина — дефект v1, названный в том же плане: список чатов лежал одновременно в
-- SQLite и в `chats.json`, и они расходились. Превью, время последнего сообщения и
-- число непрочитанных ПОЛНОСТЬЮ выводятся из таблицы `messages`. Храни их отдельно —
-- и у одного факта снова два источника правды, причём расходятся они молча: человек
-- видит в списке одно, а в чате другое, и «починить» такое можно только пересчётом,
-- то есть тем же запросом.
--
-- Отсюда и второе следствие: список НЕ МОЖЕТ ПОТЕРЯТЬ ПЕРЕПИСКУ. Строка `chats`
-- необязательна — она добавляет к переписке имя, а не создаёт её. Есть сообщение —
-- есть переписка в списке; забыть завести строку `chats` можно, потерять переписку
-- нельзя.
--
-- ── ЧЕГО СООБЩЕНИЯ НЕ ЗНАЮТ ─────────────────────────────────────────────────
--
-- Имени собеседника. `chat_id` личной переписки выводится из пары идентификаторов
-- (`PersonalChatId`), а `sender_id` у входящего до разбора пуст. Имя приезжает с
-- профилем и живёт здесь — закрытым, как и всё содержимое: имя собеседника это
-- содержимое переписки, а не метаданные.

CREATE TABLE chats (
    chat_id   TEXT    NOT NULL PRIMARY KEY,
    -- 0 — личная, 1 — группа. Столбец, а не вывод из chat_id: вид переписки решает,
    -- что показывать в шапке и кто участники, и угадывать это по идентификатору
    -- значило бы завязаться на способ его построения.
    kind      INTEGER NOT NULL DEFAULT 0,
    -- Имя под шифром покоя, тем же, что тело сообщения: имя собеседника — содержимое.
    title_enc BLOB,
    -- Идентификатор собеседника личной переписки. Нужен, чтобы взять его ключи и
    -- открыть его страницу; для группы NULL.
    peer_id   TEXT
);

-- Имя переписки: пришло с профилем или сменилось.
--
-- INSERT OR REPLACE, а не UPSERT (`ON CONFLICT DO UPDATE`): диалект проекта —
-- sqlite_3_18, потому что minSdk = 26, а UPSERT появился в SQLite 3.24. Генератор это
-- и сообщил, отказавшись разбирать `ON CONFLICT`, — то есть ограничение проверяется, а
-- не помнится. Здесь замена равнозначна: все столбцы задаются, и ссылок на строку нет.
upsertChat:
INSERT OR REPLACE INTO chats(chat_id, kind, title_enc, peer_id)
VALUES (?, ?, ?, ?);

chatById:
SELECT * FROM chats WHERE chat_id = ?;

-- Стирание переписки: строка имени уходит вместе с сообщениями. Работает вместе с
-- PRAGMA secure_delete — иначе имя остаётся в файле после «удалено».
deleteChatRow:
DELETE FROM chats WHERE chat_id = ?;

-- ── Список ──────────────────────────────────────────────────────────────────
--
-- Одна строка на переписку: последнее сообщение плюс число непрочитанных.
--
-- Оконных функций здесь нет намеренно: `minSdk = 26`, а оконные функции появились в
-- SQLite 3.25, которого на таком Android нет. Коррелированные подзапросы работают
-- везде и опираются на тот же индекс (chat_id, server_ts, client_ts, local_id), что
-- и порядок в чате.
--
-- :readState — IncomingState.READ. Непрочитанное считается только по ВХОДЯЩИМ:
-- «непрочитанным своё сообщение» не бывает.
chatList:
SELECT
    m.chat_id           AS chat_id,
    m.local_id          AS last_local_id,
    m.direction         AS last_direction,
    m.state             AS last_state,
    m.sender_id         AS last_sender,
    m.body_enc          AS last_body,
    COALESCE(m.server_ts, m.client_ts) AS last_at,
    c.kind              AS kind,
    c.title_enc         AS title_enc,
    c.peer_id           AS peer_id,
    (
        SELECT COUNT(*) FROM messages n
        WHERE n.chat_id = m.chat_id AND n.direction = 1 AND n.state != :readState
    ) AS unread
FROM messages m
-- LEFT JOIN, а не подзапрос на каждый столбец: подзапрос генератор считает
-- НЕОБНУЛЯЕМЫМ, потому что сам столбец объявлен NOT NULL, — и код падал с NPE на
-- первой же переписке без строки имени. LEFT JOIN описывает то, что есть: строки может
-- не быть, и тогда имени, вида и собеседника нет.
LEFT JOIN chats c ON c.chat_id = m.chat_id
WHERE m.local_id = (
    SELECT x.local_id FROM messages x
    WHERE x.chat_id = m.chat_id
    ORDER BY COALESCE(x.server_ts, x.client_ts) DESC, x.local_id DESC
    LIMIT 1
)
ORDER BY last_at DESC, m.local_id DESC
LIMIT :limit;

-- ── Переписки без сообщений ──────────────────────────────────────────────────
--
-- Отдельный запрос, а не объединение с `chatList`, и причина не в лени.
--
-- Список выводится из сообщений — это решение выше остаётся в силе: превью, время и
-- непрочитанное по-прежнему считаются только из `messages`, и второго источника правды у
-- них нет. Но **существование** переписки теперь бывает и без сообщений: группу создают
-- заранее, и до первого сообщения она пуста. Не показать её значит потерять то, что человек
-- только что сделал своими руками.
--
-- Почему не UNION: у второй половины все столбцы сообщения были бы NULL, а генератор берёт
-- типы из ПЕРВОЙ ветви — где они NOT NULL. Получился бы Kotlin-тип без `?` и NPE на первой
-- же пустой переписке. Ровно на этом уже падал `chatList` с коррелированным подзапросом,
-- и лечилось это LEFT JOIN. Два запроса и склейка в Kotlin — то же решение, только без
-- ловушки типов.
emptyChats:
SELECT chat_id, kind, title_enc, peer_id
FROM chats
WHERE NOT EXISTS (SELECT 1 FROM messages m WHERE m.chat_id = chats.chat_id);
