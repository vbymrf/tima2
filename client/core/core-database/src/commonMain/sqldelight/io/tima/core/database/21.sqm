-- Схема 21 → 22: пометка «только продолжение» (doc_mig/РЕДАКТОР-СООБЩЕНИЙ.md §11.3). Такое сообщение
-- в ленте переписки само не показывается — только через подкладку и прямой переход. Пометку
-- присылает сервер открытым полем (колонка там же, миграция 0077); у своего исходящего её ставит
-- редактор, и по ней же уходит поле в запрос.
ALTER TABLE messages ADD COLUMN only_continuation INTEGER NOT NULL DEFAULT 0;
