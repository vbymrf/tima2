-- Схема 22 → 23: подборка становится указателями (doc_mig/ПЛАН-(УК)-УКАЗАТЕЛЕЙ.md, УК1). У указателя —
-- раздел (пусто — «Общий»); личная подборка — у каждой переписки своя (`personal:<переписка>`) вместо
-- общей `self`: номер переписки у каждой записи есть, перенос без потерь. Разделы указателей — своя
-- таблица; сообщения-цели, полученные с сервера, — закрытые ключом устройства.
ALTER TABLE picks ADD COLUMN section_id TEXT NOT NULL DEFAULT '';

UPDATE picks SET level_key = 'personal:' || chat_id WHERE level_key = 'self';

CREATE TABLE pointer_section (
    id    TEXT    NOT NULL PRIMARY KEY,
    name  TEXT    NOT NULL,
    icon  INTEGER NOT NULL DEFAULT 0,
    place INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE ref_cache (
    chat_id   TEXT    NOT NULL,
    server_id INTEGER NOT NULL,
    kind      TEXT    NOT NULL,
    body_enc  BLOB    NOT NULL,
    PRIMARY KEY (chat_id, server_id)
);
