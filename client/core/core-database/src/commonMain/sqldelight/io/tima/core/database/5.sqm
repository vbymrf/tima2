-- Схема 5 → 6: книга контактов (ПЛАН-КОНТАКТОВ.md, Д2).
--
-- Контакты перестают выводиться из переписок и становятся своим списком: приложение
-- читает телефонную книгу устройства, но хранит своё. Причина в двух обещаниях,
-- которые зеркало телефонной книги выполнить не может: удалённый не должен
-- возвращаться при следующей синхронизации, а заведённый вручную — исчезать оттого,
-- что в телефоне его нет.
--
-- Имён два, и это решение заказчика 2026-09-05: одно поле означало бы, что правка
-- ложится поверх прочитанного из телефона, и следующая синхронизация обязана выбрать
-- — затереть правку или навсегда перестать замечать смену имени в телефоне.
CREATE TABLE book (
    phone          TEXT    NOT NULL PRIMARY KEY,
    name_phone_enc BLOB,
    name_own_enc   BLOB,
    section        TEXT    NOT NULL DEFAULT '',
    user_id        TEXT,
    manual         INTEGER NOT NULL DEFAULT 0,
    hidden         INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX book_by_section ON book (section);
CREATE INDEX book_by_user ON book (user_id);

-- Раздел живёт своей строкой: пустой существует до того, как в него кого-то положили.
CREATE TABLE book_section (
    name  TEXT    NOT NULL PRIMARY KEY,
    place INTEGER NOT NULL DEFAULT 0
);
