<?xml version="1.0" encoding="utf-8"?>
<!--
  Временный файл снимка камеры (ВЫБОР-РЕАЛИЗАЦИИ §11.2а): системная камера пишет снимок сюда,
  приложение читает его и сразу стирает — открытым на диске он не остаётся.
  Фото для «Поделиться» из просмотра (2026-10-18): один файл, стирается перед следующим.
-->
<paths>
    <cache-path name="camera" path="camera/" />
    <cache-path name="share" path="share/" />
</paths>
