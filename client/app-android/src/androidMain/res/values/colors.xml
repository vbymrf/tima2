<?xml version="1.0" encoding="utf-8"?>
<!--
  Цвет подложки иконки. Тот же салатовый, что в теме приложения (`Tokens.kt`,
  navigation = 0xFF8AC44A) и в макете (переменная «навигация» в `стиль.css`).

  Литерал здесь неизбежен: ресурсы Android о Kotlin-токенах не знают. Поэтому он назван и
  привязан комментарием — иначе они разойдутся молча.

  Имя переменной макета записано словами, а не как в CSS: два дефиса подряд внутри
  XML-комментария запрещены стандартом, и файл перестаёт разбираться.
-->
<resources>
    <color name="ic_launcher_background">#8AC44A</color>
</resources>
