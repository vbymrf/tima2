<?xml version="1.0" encoding="utf-8"?>
<!--
  Разрешения появляются вместе с тем, что их требует: INTERNET — вместе с сетью (К5),
  камера — вместе с QR, микрофон — вместе со звонками (К7). Разрешение, выданное заранее
  «чтобы потом не забыть», объяснить пользователю нельзя.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET — первое разрешение приложения, и появилось оно ровно тогда, когда
      появилась сеть: вход, отправка, живой канал. Оно не спрашивается у человека
      (install-time), но без него все сетевые вызовы падают молча, и выглядит это как
      «сервер не отвечает».
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      READ_CONTACTS появляется вместе со вкладкой «Контакты» (Д3). Спрашивается оно не
      при запуске, а при первом открытии вкладки: приложение, просящее доступ к
      контактам на первом экране, не может объяснить зачем — человек ещё не видел ни
      одного контакта.

      Разрешения на ЗАПИСЬ здесь нет и не будет: книгу телефона мы читаем, но не
      правим. Своё имя контакта живёт в нашей книге и обратно в телефон не уходит.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      REQUEST_INSTALL_PACKAGES появляется вместе с обновлением из самого приложения
      (ПЛАН-ОБНОВЛЕНИЯ.md, О4). Приложение раздаётся мимо Google Play, и поставить новую
      версию, кроме как самим, некому.

      На Android 8 и новее одного объявления мало: система спрашивает разрешение отдельно
      и для каждого источника. Спрашиваем его не при запуске, а по нажатию «Обновить» —
      только там его можно объяснить.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Звонок (К7, ПЛАН-СТЕНДА-ЗВОНКОВ С2). Появились вместе с окном 0, ни днём раньше:
      до него микрофон приложению был не нужен ни для чего.

      RECORD_AUDIO спрашивается у человека и без него звонок МОЛЧИТ: LiveKit
      публикует пустую дорожку, комната соединяется, собеседник виден — и звука нет.
      Ищется такая беда долго, потому что похожа она на что угодно, кроме разрешения.

      CAMERA — только для видеозвонка, и спрашивается отдельно от микрофона: звонок
      голосом камеры не требует, а разрешение, взятое «заодно», объяснить нельзя.

      MODIFY_AUDIO_SETTINGS не спрашивается (install-time) и нужен маршрутизации
      звука: динамик, ухо, гарнитура. Без него звонок идёт, но всегда в один выход.

      BLUETOOTH_CONNECT — только с Android 12: с него гарнитуру по Bluetooth не видно
      без разрешения. `audioswitch` внутри LiveKit его и спрашивает.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Камера и микрофон НЕ обязательны для установки: телефон без камеры остаётся
      телефоном, на котором звонят голосом. Без этих строк Google Play отсеял бы такие
      устройства сам, а раздаём мы мимо Play — и отсева не заметили бы вовсе.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      Имя и иконка. До 2026-09-16 `android:icon` здесь не было ВОВСЕ, а каталога ресурсов
      у модуля не существовало: всё это время телефон рисовал системную заглушку, и
      выглядело это как «иконка не обновилась». Подпись при этом читалась «TIMA v2» —
      внутреннее имя потока сборки, попавшее человеку на рабочий стол.
    -->
    <application
        android:name=".TimaApplication"
        android:label="TIMA"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true">

        <!--
          NoActionBar: у приложения своя шапка — салатовая плашка с названием окна. Со
          системной полосой их получалось две, и верхняя повторяла то, что и так написано
          ниже. Тема устройства, а не своя: светлую и тёмную решает человек в настройках
          телефона, и наш `isSystemInDarkTheme()` читает то же самое.
        -->
        <!--
          `adjustResize` — окно УЖИМАЕТСЯ под клавиатуру, а не съезжает вверх.

          Пока режим не задан, система выбирает его сама и на этих прошивках сдвигала всё
          окно: шапка уходила за верхний край вместе с кнопкой «назад», а низ переписки
          прятался под клавиатуру и обрезался. Выглядело это тремя разными бедами, а
          причина была одна (ПЛАН-ЧАТА.md, Ч1).

          Одного этого мало: ужатое окно означает, что нижняя часть содержимого лежит
          под клавиатурой, пока ей не дать отступ. Отступ ставится там, где рисуется
          поле ввода, — см. `imePadding` в экранах.
        -->
        <activity
            android:name=".MainActivity"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Переход по нашей схеме — вместо доступа к камере.
              Код привязки выглядит как `tima://link/v1?session_id=…`. Штатная камера
              телефона читает QR сама, видит ссылку и открывает нас; свой сканер
              потребовал бы разрешения на камеру, то есть вопроса человеку, и делал бы
              ровно то же самое. `BROWSABLE` обязателен: без него система ссылку нам не
              отдаст. Схема своя, а не https — подтверждение привязки не должно уводить
              человека в браузер, если приложение почему-то не стоит.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tima" android:host="link" />

                <!--
                  Второй наш переход — код передачи виртуального аккаунта,
                  `tima://transfer/v1?code=…` (Д12). Он появился вместе с экраном
                  передачи, а сюда вписан не был: QR рисовался, штатная камера видела
                  ссылку и не находила, кому её отдать. То есть камера — единственный
                  задуманный путь приёма — не работала вовсе, и оставалось вставлять код
                  текстом.

                  Хосты перечисляются в одном фильтре, а не в двух: у фильтра `data`
                  сочетаются схемой и хостом, и второй фильтр с той же схемой означал бы
                  копию, которую однажды поправят в одном месте из двух.
                -->
                <data android:scheme="tima" android:host="transfer" />
            </intent-filter>
        </activity>

        <!--
          Ответ системы на нашу установку. `PackageInstaller` не показывает диалог сам:
          он присылает «нужно спросить человека» вместе с готовым интентом, и запустить
          его должны мы. Без этого приёмника установка молча стоит на месте.

          exported="false": сюда пишет только система, отвечая на нашу же сессию.
        -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

    </application>

</manifest>
