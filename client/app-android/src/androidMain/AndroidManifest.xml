<?xml version="1.0" encoding="utf-8"?>
<!--
  Разрешения появляются вместе с тем, что их требует: INTERNET — вместе с сетью (К5),
  камера — вместе с QR, микрофон — вместе со звонками (К7). Разрешение, выданное заранее
  «чтобы потом не забыть», объяснить пользователю нельзя.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET — первое разрешение приложения, и появилось оно ровно тогда, когда
      появилась сеть: вход, отправка, живой канал. Оно не спрашивается у человека
      (install-time), но без него все сетевые вызовы падают молча, и выглядит это как
      «сервер не отвечает».
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      READ_CONTACTS появляется вместе со вкладкой «Контакты» (Д3). Спрашивается оно не
      при запуске, а при первом открытии вкладки: приложение, просящее доступ к
      контактам на первом экране, не может объяснить зачем — человек ещё не видел ни
      одного контакта.

      Разрешения на ЗАПИСЬ здесь нет и не будет: книгу телефона мы читаем, но не
      правим. Своё имя контакта живёт в нашей книге и обратно в телефон не уходит.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:name=".TimaApplication"
        android:label="TIMA v2"
        android:supportsRtl="true">

        <!--
          NoActionBar: у приложения своя шапка — салатовая плашка с названием окна. Со
          системной полосой их получалось две, и верхняя повторяла то, что и так написано
          ниже. Тема устройства, а не своя: светлую и тёмную решает человек в настройках
          телефона, и наш `isSystemInDarkTheme()` читает то же самое.
        -->
        <activity
            android:name=".MainActivity"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Переход по нашей схеме — вместо доступа к камере.
              Код привязки выглядит как `tima://link/v1?session_id=…`. Штатная камера
              телефона читает QR сама, видит ссылку и открывает нас; свой сканер
              потребовал бы разрешения на камеру, то есть вопроса человеку, и делал бы
              ровно то же самое. `BROWSABLE` обязателен: без него система ссылку нам не
              отдаст. Схема своя, а не https — подтверждение привязки не должно уводить
              человека в браузер, если приложение почему-то не стоит.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tima" android:host="link" />

                <!--
                  Второй наш переход — код передачи виртуального аккаунта,
                  `tima://transfer/v1?code=…` (Д12). Он появился вместе с экраном
                  передачи, а сюда вписан не был: QR рисовался, штатная камера видела
                  ссылку и не находила, кому её отдать. То есть камера — единственный
                  задуманный путь приёма — не работала вовсе, и оставалось вставлять код
                  текстом.

                  Хосты перечисляются в одном фильтре, а не в двух: у фильтра `data`
                  сочетаются схемой и хостом, и второй фильтр с той же схемой означал бы
                  копию, которую однажды поправят в одном месте из двух.
                -->
                <data android:scheme="tima" android:host="transfer" />
            </intent-filter>
        </activity>

    </application>

</manifest>
